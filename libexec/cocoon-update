#!/usr/bin/env bash
# cocoon-update — upgrade the Cocoon toolkit in place.
#
# Resolves its install prefix from its own location, then re-runs the
# installer at that prefix (idempotent by design: code refreshed, your
# apps/profiles/logins untouched).
#
# Usage:
#   cocoon-update                # upgrade to latest main
#   cocoon-update --ref v1.0.0   # upgrade/downgrade to a branch or tag
#   cocoon-update --check        # dry run: compare local vs remote version
#
# Env: COCOON_REPO=owner/repo (default sabbaghpierre/cocoon).
# Exit codes: 0 = done / already current, 1 = error, 2 = update available (--check).
set -euo pipefail

# Never inherit a hostile field separator/glob config.
unset IFS GLOBIGNORE

REPO="${COCOON_REPO:-sabbaghpierre/cocoon}"
REF="main"
CHECK=false

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "$SELF_DIR" in
  */bin | */libexec) PREFIX="$(dirname "$SELF_DIR")" ;;
  *) PREFIX="$HOME/.local/share/cocoon" ;;
esac

# Source-only path helper (stdout-silent). The legacy prefix is consulted ONLY
# for version detection below; install/write targets stay self-relative/new.
# shellcheck disable=SC1090
source "$SELF_DIR/cocoon-paths.sh" 2>/dev/null || true

cmd_version() {
  local legacy="$HOME/.local/share/webapps" p
  if [[ -f "$PREFIX/VERSION" ]]; then
    cat "$PREFIX/VERSION"
    return 0
  fi
  if declare -F cocoon_legacy_data_root >/dev/null 2>&1; then
    p="$(cocoon_legacy_data_root 2>/dev/null || true)"
    [[ -n "$p" ]] && legacy="$p"
  fi
  if [[ -f "$legacy/VERSION" ]]; then
    cat "$legacy/VERSION"
  else
    printf 'dev'
  fi
}

usage() {
  echo "Usage: cocoon-update [--ref branch-or-tag] [--check]"
}

while (($# > 0)); do
  case "$1" in
    --ref) REF="${2:?--ref needs a value}"; shift 2 ;;
    --ref=*) REF="${1#--ref=}"; shift ;;
    --check) CHECK=true; shift ;;
    -h | --help) usage; exit 0 ;;
    --version) printf '%s %s\n' "$(basename "$0")" "$(cmd_version)"; exit 0 ;;
    *) echo "cocoon-update: unknown flag: $1" >&2; usage >&2; exit 1 ;;
  esac
done

if [[ "$CHECK" == "true" ]]; then
  command -v curl >/dev/null 2>&1 || {
    echo "cocoon-update: curl is required to check for updates." >&2
    exit 1
  }
  LOCAL_VER="$(cmd_version)"
  REMOTE_VER="$(curl -fsSL "https://raw.githubusercontent.com/$REPO/$REF/VERSION" 2>/dev/null || true)"
  if [[ -z "$REMOTE_VER" ]]; then
    echo "cocoon-update: could not fetch remote version ($REPO@$REF)." >&2
    exit 1
  fi
  echo "local:  $LOCAL_VER"
  echo "remote: $REMOTE_VER ($REF)"
  if [[ "$LOCAL_VER" == "$REMOTE_VER" ]]; then
    echo "already current."
    exit 0
  else
    echo "update available: run cocoon-update [--ref $REF]."
    exit 2
  fi
fi

if [[ "$REF" != "main" ]]; then export COCOON_REF="$REF"; fi
curl -fsSL "https://raw.githubusercontent.com/$REPO/main/install.sh" |
  bash -s -- --prefix "$PREFIX"
