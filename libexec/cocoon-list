#!/usr/bin/env bash
# cocoon-list — list installed isolated cocoon.
# Usage: cocoon-list [-h|--help] [--json]
#   --json emits [{"name","engine","browser","url","desktop"}] for machine consumers.
set -euo pipefail

# Never inherit a hostile field separator/glob config.
unset IFS GLOBIGNORE

# --version source of truth: $PREFIX/VERSION shipped by install.sh.
cmd_version() {
  local d
  d="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -f "$d/../VERSION" ]]; then
    cat "$d/../VERSION"
  else
    printf 'dev'
  fi
}

if [[ "${1:-}" == "--version" ]]; then
  printf '%s %s\n' "$(basename "$0")" "$(cmd_version)"
  exit 0
fi

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "Usage: cocoon-list [--json]   (lists installed cocoon; see cocoon-help for the full toolkit)"
  exit 0
fi

JSON=false
if [[ "${1:-}" == "--json" ]]; then JSON=true; fi

DESKTOP_DIR="$HOME/.local/share/applications"

json_escape() {
  # minimal JSON string escaper for single-line fields
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\000-\037'
}

# Reverse cocoon-create's exec_escape so ids/paths read back as authored.
unescape_field() {
  printf '%s' "$1" | sed -e 's/\\\\/\\/g' -e 's/\\"/"/g' -e 's/\\\$/$/g' -e 's/\\`/`/g' -e 's/%%/%/g'
}

# parse_exec_field <exec-line> <name> -> quoted value with spaces kept intact.
parse_exec_field() {
  local line="$1" key="$2" val=""
  if [[ "$line" =~ --$key[[:space:]]+\"(([^\"\\]|\\.)*)\" ]]; then
    val="${BASH_REMATCH[1]}"
  elif [[ "$line" =~ --$key[[:space:]]+([^[:space:]\"]+) ]]; then
    val="${BASH_REMATCH[1]}"
  fi
  unescape_field "$val"
}

first=true
found=0
if [[ "$JSON" == "true" ]]; then printf '['; else printf '%-24s %-8s %-18s %s\n' "NAME" "ENGINE" "BROWSER" "URL"; fi
while IFS= read -r -d '' file; do
  exec_line="$(grep -m1 '^Exec=' "$file" || true)"
  [[ "$exec_line" == *"cocoon-launch-"* || "$exec_line" == *"cocoon launch chrome"* || "$exec_line" == *"cocoon launch firefox"* ]] || continue
  name="$(basename "${file%.desktop}")"
  engine="custom"
  [[ "$exec_line" == *"cocoon-launch-chrome"* || "$exec_line" == *" launch chrome "* ]] && engine="chrome"
  [[ "$exec_line" == *"cocoon-launch-firefox"* || "$exec_line" == *" launch firefox "* ]] && engine="firefox"
  browser="$(parse_exec_field "$exec_line" browser)"
  url="$(parse_exec_field "$exec_line" url)"
  if [[ -z "$url" ]]; then
    url="$(printf '%s' "$exec_line" | grep -oE 'https?://[^ "]*' | head -n1 || true)"
  fi
  if [[ -z "$url" ]]; then
    url="(custom exec)"
  fi
  if [[ "$JSON" == "true" ]]; then
    $first || printf ','
    first=false
    printf '{"name":"%s","engine":"%s","browser":"%s","url":"%s","desktop":"%s"}' \
      "$(json_escape "$name")" "$engine" "$(json_escape "$browser")" "$(json_escape "$url")" "$(json_escape "$file")"
  else
    printf '%-24s %-8s %-18s %s\n' "$name" "$engine" "${browser:--}" "$url"
  fi
  found=1
done < <(find "$DESKTOP_DIR" -maxdepth 1 -name '*.desktop' -print0 2>/dev/null)
if [[ "$JSON" == "true" ]]; then printf ']\n'; fi

if [[ "$found" == "0" && "$JSON" != "true" ]]; then
  echo "(no cocoon installed)"
fi
