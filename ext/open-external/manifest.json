{
  "manifest_version": 3,
  "name": "webapp-kit link router",
  "version": "0.0.2",
  "description": "Opens every clicked link in the system default browser via the webapp-kit native host. Loaded unpacked by webapp-launch-chrome into isolated webapp windows.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
